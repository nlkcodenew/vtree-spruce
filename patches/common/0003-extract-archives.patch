index c376118..94bfdc0 100644
--- a/fileop.c
+++ b/fileop.c
@@ -8,6 +8,8 @@
 #include <ctype.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <strings.h>
+#include <sys/wait.h>
 #ifdef __linux__
 #  include <sys/syscall.h>
 #  ifdef SYS_copy_file_range
@@ -309,3 +311,140 @@ int delete_path(const char* path) {
     if (r != 0) vtree_log("[delete] unlink FAILED: %s (errno %d: %s)\n", path, errno, strerror(errno));
     return r;
 }
+
+// ---- archive extraction ----
+
+static bool has_ext_ci(const char *name, const char *ext) {
+    size_t n = strlen(name), e = strlen(ext);
+    return n > e && strcasecmp(name + n - e, ext) == 0;
+}
+
+// True if the file name looks like a supported archive.
+// Kept tight on purpose: zip, rar, 7z, tar, gz, tgz.
+bool is_archive_name(const char *name) {
+    static const char *exts[] = { ".zip", ".rar", ".7z", ".tar", ".gz", ".tgz" };
+    size_t i;
+
+    if (!name || !*name) return false;
+    for (i = 0; i < sizeof(exts) / sizeof(exts[0]); i++)
+        if (has_ext_ci(name, exts[i])) return true;
+    return false;
+}
+
+// Derive the destination folder leaf from the archive file name:
+// basename minus the archive suffix (longest suffix wins, so
+// "backup.tar.gz" becomes "backup", not "backup.tar").
+static void archive_dir_leaf(const char *name, char *out, size_t out_len) {
+    static const char *suffixes[] = {
+        ".tar.gz", ".zip", ".rar", ".7z", ".tar", ".tgz", ".gz",
+    };
+    size_t n = strlen(name), cut = 0, i, leaf_len;
+
+    for (i = 0; i < sizeof(suffixes) / sizeof(suffixes[0]); i++) {
+        size_t e = strlen(suffixes[i]);
+        if (n > e && strcasecmp(name + n - e, suffixes[i]) == 0) { cut = e; break; }
+    }
+    leaf_len = n - cut;
+    if (leaf_len == 0) leaf_len = n;  // name was only an extension (".zip"): keep it
+    if (leaf_len >= out_len) leaf_len = out_len - 1;
+    memcpy(out, name, leaf_len);
+    out[leaf_len] = 0;
+    if (out[0] == 0 || strcmp(out, ".") == 0 || strcmp(out, "..") == 0)
+        snprintf(out, out_len, "extracted");
+}
+
+// Extract an archive into a new subdirectory of dest_parent named after
+// the archive (no extension); appends _1, _2, ... on name collisions.
+// Returns 0 on success, -1 on failure with errbuf filled in.
+//
+// The extractor is fork+exec-ed, never system(): the bundled static 7zz at
+// <exe_dir>/bin/7zz handles zip/7z/rar/tar/gz; when it is missing we fall
+// back to the system unzip, but only for .zip files. Runs synchronously,
+// like paste in v1.1 (no progress dialog exists yet).
+int extract_archive(const char *archive_path, const char *dest_parent,
+                    char *errbuf, size_t errbuf_len) {
+    struct stat ast, st;
+    const char *slash, *base;
+    char leaf[256], destbase[MAX_PATH], dest[MAX_PATH], sevenzz[MAX_PATH];
+    char outopt[MAX_PATH + 3];
+    bool have_7zz = false;
+    pid_t pid;
+    int status, n = 0;
+
+    if (errbuf && errbuf_len) errbuf[0] = 0;
+
+    if (!archive_path || !dest_parent) {
+        snprintf(errbuf, errbuf_len, "Bad arguments");
+        return -1;
+    }
+    if (stat(archive_path, &ast) != 0 || !S_ISREG(ast.st_mode)) {
+        snprintf(errbuf, errbuf_len, "Not a file: %.200s", archive_path);
+        return -1;
+    }
+
+    slash = strrchr(archive_path, '/');
+    base = slash ? slash + 1 : archive_path;
+    archive_dir_leaf(base, leaf, sizeof(leaf));
+
+    // Pick a non-colliding destination dir.
+    join_path(destbase, dest_parent, leaf);
+    strncpy(dest, destbase, sizeof(dest) - 1);
+    dest[sizeof(dest) - 1] = 0;
+    while (stat(dest, &st) == 0) {
+        if (++n > 999) {
+            snprintf(errbuf, errbuf_len, "Too many existing folders");
+            return -1;
+        }
+        if (snprintf(dest, sizeof(dest), "%s_%d", destbase, n) >= (int)sizeof(dest)) {
+            snprintf(errbuf, errbuf_len, "Path too long");
+            return -1;
+        }
+    }
+
+    // Choose the extractor.
+    if (vtree_exe_dir[0] != 0) {
+        join_path(sevenzz, vtree_exe_dir, "bin/7zz");
+        have_7zz = (access(sevenzz, X_OK) == 0);
+    }
+    if (!have_7zz && !has_ext_ci(base, ".zip")) {
+        snprintf(errbuf, errbuf_len, "No extractor for %.32s (7zz missing)", base);
+        return -1;
+    }
+
+    if (mkdir(dest, 0755) != 0) {
+        snprintf(errbuf, errbuf_len, "mkdir failed: %.200s", strerror(errno));
+        return -1;
+    }
+
+    pid = fork();
+    if (pid < 0) {
+        snprintf(errbuf, errbuf_len, "fork failed: %.200s", strerror(errno));
+        rmdir(dest);
+        return -1;
+    }
+    if (pid == 0) {
+        // Child: never block on a password prompt; answer yes to overwrites.
+        int dn = open("/dev/null", O_RDONLY);
+        if (dn >= 0) {
+            dup2(dn, STDIN_FILENO);
+            if (dn != STDIN_FILENO) close(dn);
+        }
+        if (have_7zz) {
+            // 7zz x -o<dest> -y <archive>  (argv array, no shell involved)
+            snprintf(outopt, sizeof(outopt), "-o%s", dest);
+            execl(sevenzz, "7zz", "x", outopt, "-y", archive_path, (char *)NULL);
+        } else {
+            execlp("unzip", "unzip", "-q", "-o", archive_path, "-d", dest, (char *)NULL);
+        }
+        _exit(127);  // execl failed
+    }
+    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) { /* retry */ }
+    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        int code = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+        snprintf(errbuf, errbuf_len, "Extractor failed (code %d)", code);
+        return -1;
+    }
+    vtree_log("[extract] %s -> %s (%s)\n",
+              archive_path, dest, have_7zz ? "7zz" : "unzip");
+    return 0;
+}
