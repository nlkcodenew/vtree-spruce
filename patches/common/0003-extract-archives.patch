+// True when the Extract entry must be skipped/disabled: only a single
+// archive file under the cursor can be extracted (never "..", never a dir).
+static bool menu_extract_unavailable(void) {
+    AppState *ps = &panes[active_pane];
+    if (ps->file_count <= 0 || ps->selected_index < 0 ||
+        ps->selected_index >= ps->file_count)
+        return true;
+    FileEntry *fe = &ps->files[ps->selected_index];
+    if (fe->is_dir || strcmp(fe->name, "..") == 0)
+        return true;
+    return !is_archive_name(fe->name);
+}
