+int crypto_sign_ed25519_open(u8 *m,u64 *mlen,const u8 *sm,u64 n,const u8 *pk)
+{
+  int i;
+  u8 t[32],h[64];
+  gf p[4],q[4];
+
+  *mlen = -1;
+  if (n < 64) return -1;
+
+  if (unpackneg(q,pk)) return -1;
+
+  FOR(i,n) m[i] = sm[i];
+  FOR(i,32) m[i+32] = pk[i];
+  crypto_hash_sha512(h,m,n);
+  reduce(h);
+  scalarmult(p,q,h);
+
+  scalarbase(q,sm + 32);
+  add(p,q);
+  pack(t,p);
+
+  n -= 64;
+  if (crypto_verify_32(sm, t)) {
+    FOR(i,n) m[i] = 0;
+    return -1;
+  }
+
+  FOR(i,n) m[i] = sm[i + 64];
+  *mlen = n;
+  return 0;
+}
+
+#pragma GCC diagnostic pop
+
+
+
+// Embedded release public key (kid "fm1"). Private key stays offline.
+static const unsigned char ota_pubkey_fm1[32] = {
+    0x13, 0x1c, 0x81, 0xac, 0xcc, 0x1e, 0xe2, 0x86,
+    0x51, 0x4a, 0xbb, 0xda, 0xfc, 0x20, 0x79, 0xf4,
+    0x88, 0x9e, 0xe8, 0xdb, 0xa6, 0x19, 0xb2, 0x17,
+    0x4f, 0xb7, 0xd4, 0x07, 0x85, 0x8e, 0x3f, 0x53
+};
+
+// ---------- minimal JSON parser (just enough for the manifest) ----------
+
+typedef enum { OJ_NUL, OJ_STR, OJ_NUM, OJ_ARR, OJ_OBJ } oj_type_t;
+
+typedef struct oj_val oj_val_t;
+typedef struct { char *k; oj_val_t *v; } oj_kv_t;
+
+struct oj_val {
+    oj_type_t t;
+    char *s;            /* OJ_STR: decoded */
+    long long num;      /* OJ_NUM */
+    oj_val_t **items;   /* OJ_ARR */
+    int nitems;
+    oj_kv_t *kv;        /* OJ_OBJ */
+    int nkv;
+};
+
+typedef struct {
+    const char *p;
+    const char *end;
+    int fail;
+} oj_parser_t;
+
+static void oj_ws(oj_parser_t *j) {
+    while (j->p < j->end && (*j->p == ' ' || *j->p == '\t' ||
+                             *j->p == '\n' || *j->p == '\r'))
+        j->p++;
+}
+
+static oj_val_t *oj_new(oj_type_t t) {
+    oj_val_t *v = (oj_val_t *)calloc(1, sizeof(*v));
+    if (v) v->t = t;
+    return v;
+}
+
+static void oj_free(oj_val_t *v) {
+    int i;
+    if (!v) return;
+    if (v->t == OJ_STR) free(v->s);
+    if (v->t == OJ_ARR) {
+        for (i = 0; i < v->nitems; i++) oj_free(v->items[i]);
+        free(v->items);
+    }
+    if (v->t == OJ_OBJ) {
+        for (i = 0; i < v->nkv; i++) { free(v->kv[i].k); oj_free(v->kv[i].v); }
+        free(v->kv);
+    }
+    free(v);
+}
+
+/* Decode one \uXXXX escape into UTF-8. Returns bytes written (1-3) or -1. */
+static int oj_unescape_u(const char *p, const char *end, char *out) {
+    unsigned v = 0;
+    int i;
+    if (end - p < 4) return -1;
+    for (i = 0; i < 4; i++) {
+        char c = p[i];
+        v <<= 4;
+        if (c >= '0' && c <= '9') v |= (unsigned)(c - '0');
+        else if (c >= 'a' && c <= 'f') v |= (unsigned)(c - 'a' + 10);
+        else if (c >= 'A' && c <= 'F') v |= (unsigned)(c - 'A' + 10);
+        else return -1;
+    }
+    if (v < 0x80) { out[0] = (char)v; return 1; }
+    if (v < 0x800) {
+        out[0] = (char)(0xC0 | (v >> 6));
+        out[1] = (char)(0x80 | (v & 0x3F));
+        return 2;
+    }
+    out[0] = (char)(0xE0 | (v >> 12));
+    out[1] = (char)(0x80 | ((v >> 6) & 0x3F));
+    out[2] = (char)(0x80 | (v & 0x3F));
+    return 3;
+}
+
+/* Parse a JSON string; *out receives malloc'd decoded string. 0 = ok. */
+static int oj_parse_string(oj_parser_t *j, char **out) {
+    /* worst case: decoded length <= encoded length */
+    size_t cap = (size_t)(j->end - j->p) + 1;
+    char *buf;
+    size_t n = 0;
+    *out = NULL;
+    if (j->p >= j->end || *j->p != '"') { j->fail = 1; return -1; }
+    j->p++;
+    buf = (char *)malloc(cap);
+    if (!buf) { j->fail = 1; return -1; }
+    while (j->p < j->end) {
+        char c = *j->p++;
+        if (c == '"') {
+            buf[n] = 0;
+            *out = buf;
+            return 0;
+        }
+        if (c == '\\') {
+            char e;
+            int w;
+            char tmp[3];
+            if (j->p >= j->end) break;
+            e = *j->p++;
+            switch (e) {
+            case '"': buf[n++] = '"'; break;
+            case '\\': buf[n++] = '\\'; break;
+            case '/': buf[n++] = '/'; break;
+            case 'b': buf[n++] = '\b'; break;
+            case 'f': buf[n++] = '\f'; break;
+            case 'n': buf[n++] = '\n'; break;
+            case 'r': buf[n++] = '\r'; break;
+            case 't': buf[n++] = '\t'; break;
+            case 'u':
+                w = oj_unescape_u(j->p, j->end, tmp);
+                if (w < 0) break;
+                memcpy(buf + n, tmp, (size_t)w);
+                n += (size_t)w;
+                j->p += 4;
+                break;
+            default: break; /* invalid escape -> fail below */
+            }
+            if (e == 'u' && w < 0) break;
+            if (e != '"' && e != '\\' && e != '/' && e != 'b' && e != 'f' &&
+                e != 'n' && e != 'r' && e != 't' && e != 'u') break;
+            continue;
+        }
+        if ((unsigned char)c < 0x20) break; /* raw control char: invalid */
+        buf[n++] = c;
+    }
+    free(buf);
+    j->fail = 1;
+    return -1;
+}
+
+static oj_val_t *oj_parse_value(oj_parser_t *j);
+
+static oj_val_t *oj_parse_array(oj_parser_t *j) {
+    oj_val_t *a = oj_new(OJ_ARR);
+    j->p++; /* [ */
+    if (!a) { j->fail = 1; return NULL; }
+    oj_ws(j);
+    if (j->p < j->end && *j->p == ']') { j->p++; return a; }
+    while (j->p < j->end) {
+        oj_val_t *v = oj_parse_value(j);
+        oj_val_t **ni;
+        if (!v) { oj_free(a); return NULL; }
+        ni = (oj_val_t **)realloc(a->items, (size_t)(a->nitems + 1) * sizeof(*ni));
+        if (!ni) { oj_free(v); oj_free(a); j->fail = 1; return NULL; }
+        a->items = ni;
+        a->items[a->nitems++] = v;
+        oj_ws(j);
+        if (j->p < j->end && *j->p == ',') { j->p++; oj_ws(j); continue; }
+        if (j->p < j->end && *j->p == ']') { j->p++; return a; }
+        j->fail = 1;
+        oj_free(a);
+        return NULL;
+    }
+    j->fail = 1;
+    oj_free(a);
+    return NULL;
+}
+
+static oj_val_t *oj_parse_object(oj_parser_t *j) {
+    oj_val_t *o = oj_new(OJ_OBJ);
+    j->p++; /* { */
+    if (!o) { j->fail = 1; return NULL; }
+    oj_ws(j);
+    if (j->p < j->end && *j->p == '}') { j->p++; return o; }
+    while (j->p < j->end) {
+        char *k = NULL;
+        oj_val_t *v;
+        oj_kv_t *nk;
+        if (oj_parse_string(j, &k) != 0 || !k) { oj_free(o); return NULL; }
+        oj_ws(j);
+        if (j->p >= j->end || *j->p != ':') { free(k); oj_free(o); j->fail = 1; return NULL; }
+        j->p++;
+        oj_ws(j);
+        v = oj_parse_value(j);
+        if (!v) { free(k); oj_free(o); return NULL; }
+        nk = (oj_kv_t *)realloc(o->kv, (size_t)(o->nkv + 1) * sizeof(*nk));
+        if (!nk) { free(k); oj_free(v); oj_free(o); j->fail = 1; return NULL; }
+        o->kv = nk;
+        o->kv[o->nkv].k = k;
+        o->kv[o->nkv].v = v;
+        o->nkv++;
+        oj_ws(j);
+        if (j->p < j->end && *j->p == ',') { j->p++; oj_ws(j); continue; }
+        if (j->p < j->end && *j->p == '}') { j->p++; return o; }
+        j->fail = 1;
+        oj_free(o);
+        return NULL;
+    }
+    j->fail = 1;
+    oj_free(o);
+    return NULL;
+}
+
+static oj_val_t *oj_parse_value(oj_parser_t *j) {
+    oj_val_t *v;
+    oj_ws(j);
+    if (j->p >= j->end) { j->fail = 1; return NULL; }
+    switch (*j->p) {
+    case '{': return oj_parse_object(j);
+    case '[': return oj_parse_array(j);
+    case '"':
+        v = oj_new(OJ_STR);
+        if (!v || oj_parse_string(j, &v->s) != 0) { oj_free(v); return NULL; }
+        return v;
+    case 't':
+        if ((size_t)(j->end - j->p) >= 4 && memcmp(j->p, "true", 4) == 0) {
+            j->p += 4;
+            return oj_new(OJ_NUL);
+        }
+        break;
+    case 'f':
+        if ((size_t)(j->end - j->p) >= 5 && memcmp(j->p, "false", 5) == 0) {
+            j->p += 5;
+            return oj_new(OJ_NUL);
+        }
+        break;
+    case 'n':
+        if ((size_t)(j->end - j->p) >= 4 && memcmp(j->p, "null", 4) == 0) {
+            j->p += 4;
+            return oj_new(OJ_NUL);
+        }
+        break;
+    default:
+        break;
+    }
+    /* number */
+    if (*j->p == '-' || (*j->p >= '0' && *j->p <= '9')) {
+        const char *s = j->p;
+        char *e = NULL;
+        long long n;
+        if (*j->p == '-') j->p++;
+        while (j->p < j->end && *j->p >= '0' && *j->p <= '9') j->p++;
+        if (j->p < j->end && *j->p == '.') {
+            j->p++;
+            while (j->p < j->end && *j->p >= '0' && *j->p <= '9') j->p++;
+        }
+        if (j->p < j->end && (*j->p == 'e' || *j->p == 'E')) {
+            j->p++;
+            if (j->p < j->end && (*j->p == '+' || *j->p == '-')) j->p++;
+            while (j->p < j->end && *j->p >= '0' && *j->p <= '9') j->p++;
+        }
+        n = strtoll(s, &e, 10);
+        if (e != j->p) { j->fail = 1; return NULL; }
+        v = oj_new(OJ_NUM);
+        if (!v) { j->fail = 1; return NULL; }
+        v->num = n;
+        return v;
+    }
+    j->fail = 1;
+    return NULL;
+}
+
+static const oj_val_t *oj_get(const oj_val_t *obj, const char *key) {
+    int i;
+    if (!obj || obj->t != OJ_OBJ) return NULL;
+    for (i = 0; i < obj->nkv; i++)
+        if (strcmp(obj->kv[i].k, key) == 0)
+            return obj->kv[i].v;
+    return NULL;
+}
+
+// ---------- base64url decode ----------
+
+static int oj_b64val(char c) {
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '-') return 62;
+    if (c == '_') return 63;
+    return -1;
+}
+
+/* Returns decoded length, or -1 on error. */
+static int oj_b64url_decode(const char *in, unsigned char *out, size_t outcap) {
+    size_t n = 0;
+    int bits = 0;
+    unsigned acc = 0;
+    while (*in) {
+        int v;
+        if (*in == '=') break;
+        v = oj_b64val(*in++);
+        if (v < 0) return -1;
+        acc = (acc << 6) | (unsigned)v;
+        bits += 6;
+        if (bits >= 8) {
+            bits -= 8;
+            if (n >= outcap) return -1;
+            out[n++] = (unsigned char)(acc >> bits);
+            acc &= (bits == 0) ? 0u : ((1u << bits) - 1u);
+        }
+    }
+    return (int)n;
+}
+
+// ---------- canonical JSON serialization ----------
+
+typedef struct {
+    char *buf;
+    size_t len;
+    size_t cap;
+    int fail;
+} oj_sb_t;
+
+static void oj_sb_reserve(oj_sb_t *sb, size_t extra) {
+    if (sb->fail) return;
+    if (sb->len + extra + 1 > sb->cap) {
+        size_t ncap = sb->cap ? sb->cap * 2 : 256;
+        char *nb;
+        while (ncap < sb->len + extra + 1) ncap *= 2;
+        nb = (char *)realloc(sb->buf, ncap);
+        if (!nb) { sb->fail = 1; return; }
+        sb->buf = nb;
+        sb->cap = ncap;
+    }
+}
+
+static void oj_sb_addn(oj_sb_t *sb, const char *s, size_t n) {
+    oj_sb_reserve(sb, n);
+    if (sb->fail) return;
+    memcpy(sb->buf + sb->len, s, n);
+    sb->len += n;
+    sb->buf[sb->len] = 0;
+}
+
+static void oj_sb_add(oj_sb_t *sb, const char *s) {
+    oj_sb_addn(sb, s, strlen(s));
+}
+
+static void oj_sb_addc(oj_sb_t *sb, char c) {
+    oj_sb_addn(sb, &c, 1);
+}
+
+/* Escape exactly like Python's json.dumps(ensure_ascii=False): only
+ * '"', '\\' and control chars are escaped; UTF-8 passes through. */
+static void oj_sb_jescape(oj_sb_t *sb, const char *s) {
+    static const char *hexd = "0123456789abcdef";
+    char esc[6];
+    while (*s) {
+        unsigned char c = (unsigned char)*s++;
+        switch (c) {
+        case '"': oj_sb_add(sb, "\\\""); break;
+        case '\\': oj_sb_add(sb, "\\\\"); break;
+        case '\b': oj_sb_add(sb, "\\b"); break;
+        case '\f': oj_sb_add(sb, "\\f"); break;
+        case '\n': oj_sb_add(sb, "\\n"); break;
+        case '\r': oj_sb_add(sb, "\\r"); break;
+        case '\t': oj_sb_add(sb, "\\t"); break;
+        default:
+            if (c < 0x20) {
+                esc[0] = '\\'; esc[1] = 'u'; esc[2] = '0'; esc[3] = '0';
+                esc[4] = hexd[(c >> 4) & 0xF]; esc[5] = hexd[c & 0xF];
+                oj_sb_addn(sb, esc, 6);
+            } else {
+                oj_sb_addc(sb, (char)c);
+            }
+            break;
+        }
+    }
+}
+
+// ---------- manifest validation ----------
+
+static int oj_is_hex64(const char *s) {
+    int i;
+    if (strlen(s) != 64) return 0;
+    for (i = 0; i < 64; i++) {
+        char c = s[i];
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') ||
+              (c >= 'A' && c <= 'F')))
+            return 0;
+    }
+    return 1;
+}
+
+/* Reject anything that is not a plain file name (no dirs, no traversal). */
+static int oj_safe_name(const char *s) {
+    if (!s || !*s) return 0;
+    if (strcmp(s, ".") == 0 || strcmp(s, "..") == 0) return 0;
+    if (strchr(s, '/') || strchr(s, '\\')) return 0;
+    if (strstr(s, "..")) return 0;
+    return 1;
+}
+
+typedef struct {
+    const char *path;
+    const char *sha256;
+    const char *url;
+    long long size;
+} oj_file_t;
+
+static int oj_file_cmp(const void *a, const void *b) {
+    return strcmp(((const oj_file_t *)a)->path, ((const oj_file_t *)b)->path);
+}
+
+// ---------- main entry ----------
+
+// Verify the OTA manifest at `path`. Returns 0 if the Ed25519 signature is
+// valid (prints OK to stdout), -1 otherwise (reason on stderr).
+int ota_verify_manifest(const char *path) {
+    FILE *f;
+    long fsize;
+    char *text = NULL;
+    size_t nread;
+    oj_parser_t jp;
+    oj_val_t *root = NULL;
+    const oj_val_t *jver, *jkid, *jsig, *jfiles;
+    oj_file_t *files = NULL;
+    int nfiles = 0;
+    int i, rc = -1;
+    unsigned char sig[64];
+    int siglen;
+    oj_sb_t sb;
+    unsigned char *sm = NULL;
+    unsigned char *m = NULL;
+    u64 mlen = 0;
+    int vrc;
+
+    memset(&sb, 0, sizeof(sb));
+
+    f = fopen(path, "rb");
+    if (!f) {
+        fprintf(stderr, "[ota] cannot open manifest: %s\n", path);
+        return -1;
+    }
+    fseek(f, 0, SEEK_END);
+    fsize = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (fsize <= 0 || fsize > 65536) {
+        fprintf(stderr, "[ota] bad manifest size\n");
+        fclose(f);
+        return -1;
+    }
+    text = (char *)malloc((size_t)fsize + 1);
+    if (!text) { fclose(f); return -1; }
+    nread = fread(text, 1, (size_t)fsize, f);
+    fclose(f);
+    if (nread != (size_t)fsize) { free(text); return -1; }
+    text[fsize] = 0;
+
+    jp.p = text;
+    jp.end = text + fsize;
+    jp.fail = 0;
+    root = oj_parse_value(&jp);
+    if (!root || jp.fail || root->t != OJ_OBJ) {
+        fprintf(stderr, "[ota] manifest is not valid JSON\n");
+        goto done;
+    }
+    oj_ws(&jp);
+    if (jp.p != jp.end) { /* trailing garbage */
+        fprintf(stderr, "[ota] manifest has trailing data\n");
+        goto done;
+    }
+
+    jver = oj_get(root, "version");
+    jkid = oj_get(root, "kid");
+    jsig = oj_get(root, "signature");
+    jfiles = oj_get(root, "files");
+    if (!jver || jver->t != OJ_STR || !jver->s[0] ||
+        !jkid || jkid->t != OJ_STR || !jkid->s[0] ||
+        !jsig || jsig->t != OJ_STR || !jsig->s[0] ||
+        !jfiles || jfiles->t != OJ_ARR || jfiles->nitems == 0) {
+        fprintf(stderr, "[ota] manifest missing required fields\n");
+        goto done;
+    }
+    if (strcmp(jkid->s, "fm1") != 0) {
+        fprintf(stderr, "[ota] unknown kid: %s\n", jkid->s);
+        goto done;
+    }
+
+    nfiles = jfiles->nitems;
+    files = (oj_file_t *)calloc((size_t)nfiles, sizeof(*files));
+    if (!files) goto done;
+    for (i = 0; i < nfiles; i++) {
+        const oj_val_t *e = jfiles->items[i];
+        const oj_val_t *jp_, *js, *jz, *ju;
+        if (!e || e->t != OJ_OBJ) {
+            fprintf(stderr, "[ota] bad file entry %d\n", i);
+            goto done;
+        }
+        jp_ = oj_get(e, "path");
+        js = oj_get(e, "sha256");
+        jz = oj_get(e, "size");
+        ju = oj_get(e, "url");
+        if (!jp_ || jp_->t != OJ_STR || !oj_safe_name(jp_->s) ||
+            !js || js->t != OJ_STR || !oj_is_hex64(js->s) ||
+            !jz || jz->t != OJ_NUM || jz->num <= 0 ||
+            jz->num > (long long)(100 * 1024 * 1024) ||
+            !ju || ju->t != OJ_STR || !ju->s[0]) {
+            fprintf(stderr, "[ota] bad file entry %d\n", i);
+            goto done;
+        }
+        files[i].path = jp_->s;
+        files[i].sha256 = js->s;
+        files[i].url = ju->s;
+        files[i].size = jz->num;
+    }
+    qsort(files, (size_t)nfiles, sizeof(*files), oj_file_cmp);
+    for (i = 1; i < nfiles; i++) {
+        if (strcmp(files[i].path, files[i - 1].path) == 0) {
+            fprintf(stderr, "[ota] duplicate path: %s\n", files[i].path);
+            goto done;
+        }
+    }
+
+    /* Canonical body — must match make_manifest.py byte for byte. */
+    oj_sb_add(&sb, "{\"files\":[");
+    for (i = 0; i < nfiles; i++) {
+        char numbuf[32];
+        if (i) oj_sb_addc(&sb, ',');
+        oj_sb_add(&sb, "{\"path\":\"");
+        oj_sb_jescape(&sb, files[i].path);
+        oj_sb_add(&sb, "\",\"sha256\":\"");
+        oj_sb_add(&sb, files[i].sha256);
+        oj_sb_add(&sb, "\",\"size\":");
+        snprintf(numbuf, sizeof(numbuf), "%lld", files[i].size);
+        oj_sb_add(&sb, numbuf);
+        oj_sb_add(&sb, ",\"url\":\"");
+        oj_sb_jescape(&sb, files[i].url);
+        oj_sb_add(&sb, "\"}");
+    }
+    oj_sb_add(&sb, "],\"kid\":\"");
+    oj_sb_jescape(&sb, jkid->s);
+    oj_sb_add(&sb, "\",\"version\":\"");
+    oj_sb_jescape(&sb, jver->s);
+    oj_sb_add(&sb, "\"}");
+    if (sb.fail || !sb.buf) {
+        fprintf(stderr, "[ota] out of memory\n");
+        goto done;
+    }
+
+    siglen = oj_b64url_decode(jsig->s, sig, sizeof(sig));
+    if (siglen != 64) {
+        fprintf(stderr, "[ota] bad signature encoding\n");
+        goto done;
+    }
+
+    sm = (unsigned char *)malloc((size_t)64 + sb.len);
+    m = (unsigned char *)malloc((size_t)64 + sb.len);
+    if (!sm || !m) {
+        fprintf(stderr, "[ota] out of memory\n");
+        goto done;
+    }
+    memcpy(sm, sig, 64);
+    memcpy(sm + 64, sb.buf, sb.len);
+    vrc = crypto_sign_ed25519_open(m, &mlen, sm, (u64)(64 + sb.len), ota_pubkey_fm1);
+    if (vrc != 0) {
+        fprintf(stderr, "[ota] Ed25519 signature INVALID\n");
+        goto done;
+    }
+
+    printf("OK: manifest valid: version=%s kid=%s (%d files)\n",
+           jver->s, jkid->s, nfiles);
+    rc = 0;
+
+done:
+    free(sm);
+    free(m);
+    free(files);
+    free(sb.buf);
+    oj_free(root);
+    free(text);
+    return rc;
+}
