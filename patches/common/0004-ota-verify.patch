+#else
+
+static void M(gf o,const gf a,const gf b)
+{
+  unsigned i;
+  u16 as[16];
+  u16 bs[16];
+
+  CS(as, a);
+  CS(bs, b);
+
+  i64 t[31],v;
+  FOR(i,31) t[i]=0;
+  i64* pt = &t[15];
+  for (u16* asp = &as[15]; asp >= as; asp--, pt--) {
+    u32 asi = *asp;
+    i64* ppt = pt + 15;
+    for (u16* bsp = &bs[15]; bsp >= bs; bsp--, ppt--) {
+      v=*ppt;
+      v+=(i64)(asi * (u32)*bsp);
+      *ppt=v;
+    }
+  }
+  FOR(i,15) { v=t[i+16]; v=MUL38(v); o[i]=t[i]+v; }
+  o[15]=t[15];
+}
+
+static void S(gf o,const gf a)
+{
+  unsigned i,j;
+  u16 as[16];
+
+  CS(as, a);
+
+  i64 t[31],v;
+  FOR(i,31) t[i]=0;
+  FOR(i,16) {
+    u32 ai = (u32)as[i];
+    t[i<<1]+=(u32)(ai*ai);
+    for(j=i+1;j<16;j++) {
+      v=t[i+j];
+      v+=((i64)(ai*(u32)as[j]))<<1;
+      t[i+j]=v;
+    }
+  }
+  FOR(i,15) { v=t[i+16]; v=MUL38(v); o[i]=t[i]+v; }
+  o[15]=t[15];
+}
