From 772ad6f1b099fcc07cb74dea7bbabc36b3e3e275 Mon Sep 17 00:00:00 2001
From: Muse <muse@local>
Date: Sat, 17 Oct 2026 14:06:49 +0700
Subject: [PATCH] port: 0001 nintendo button labels

---
 keyboard.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/keyboard.c b/keyboard.c
index c9734e7..3f9fcfe 100644
--- a/keyboard.c
+++ b/keyboard.c
@@ -283,10 +283,10 @@ const char *btn_label(SDL_GameControllerButton btn) {
 
     const char *s = SDL_GameControllerGetStringForButton(btn);
     if (!s) return "?";
-    if (strcmp(s, "a")             == 0) return "A";
-    if (strcmp(s, "b")             == 0) return "B";
-    if (strcmp(s, "x")             == 0) return "X";
-    if (strcmp(s, "y")             == 0) return "Y";
+    if (strcmp(s, "a")             == 0) return "B";
+    if (strcmp(s, "b")             == 0) return "A";
+    if (strcmp(s, "x")             == 0) return "Y";
+    if (strcmp(s, "y")             == 0) return "X";
     if (strcmp(s, "start")         == 0) return "Start";
     if (strcmp(s, "guide")         == 0) return "Guide";
     if (strcmp(s, "back")          == 0) return "Select";
-- 
