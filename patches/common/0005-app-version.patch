 // ---------------------------------------------------------------------------
 #define VTREE_VERSION "1.1"
 
+// ---------------------------------------------------------------------------
+// App release version (FileManagement) — read from the VERSION file shipped
+// next to the binary (written by release packaging / OTA updater).
+// Falls back to the upstream vTree version when the file is missing, so
+// dev builds without a VERSION file still show something sensible.
+// launch.sh cds into the app dir before exec, so a relative path works.
+// ---------------------------------------------------------------------------
+static char g_app_version[32] = "";
+static const char *app_version(void) {
+    if (g_app_version[0] != '\0') return g_app_version;
+    FILE *f = fopen("VERSION", "r");
+    if (f) {
+        size_t n = fread(g_app_version, 1, sizeof(g_app_version) - 1, f);
+        fclose(f);
+        g_app_version[n] = '\0';
+        while (n > 0 && (g_app_version[n - 1] == '\n' || g_app_version[n - 1] == '\r' ||
+                         g_app_version[n - 1] == ' ' || g_app_version[n - 1] == '\t'))
+            g_app_version[--n] = '\0';
+        {
+            char *q = g_app_version;
+            while (*q == ' ' || *q == '\t') q++;
+            if (q != g_app_version) memmove(g_app_version, q, strlen(q) + 1);
+        }
+    }
+    if (g_app_version[0] == '\0')
+        snprintf(g_app_version, sizeof(g_app_version), "%s", VTREE_VERSION);
+    return g_app_version;
+}
